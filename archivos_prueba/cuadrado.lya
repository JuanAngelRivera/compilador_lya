paquete figuras_geometricas;

publico clase cuadrado hereda figura {

    cuadrado(double lado) {
        super.figura();
        super.lado = lado;
        super.numero_lados = 4;
    }

    @override
    double area() {
        retorna lado * lado;
    }

    @override
    double perimetro() {
        retorna lado * numero_lados;
    }
}